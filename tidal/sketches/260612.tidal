--at rc / livecode session. 

-- $ signifies a pattern; # is modification. for a pattern to be enclosed, you can use parentheses.
d1 $ stack [
    slow 2 (
    s "bd bd [bd*2] ~ bd bd") # s "808",
    fast 2(s "hh hh [hh*2]")
]

-- d1 $ fast 2 $ stack [
